---
import type { WritingEntry } from '../data/writing';

interface Props {
  posts: WritingEntry[];
  dateFormat?: 'short' | 'long';
}

const { posts, dateFormat = 'short' } = Astro.props;

function fmt(d: Date) {
  const opts: Intl.DateTimeFormatOptions =
    dateFormat === 'long'
      ? { year: 'numeric', month: 'short', day: 'numeric' }
      : { year: 'numeric', month: 'short' };
  return d.toLocaleDateString('en-US', opts);
}
---
<ul class="post-list">
  {posts.map((p) => (
    <li>
      <a href={p.url} class="row" target="_blank" rel="noopener">
        <span class="entry">
          <span class="title">{p.title}</span>
          {(p.authors || p.venue) && (
            <span class="venue">{[p.authors, p.venue].filter(Boolean).join(' · ')}</span>
          )}
        </span>
        <span class="date">{fmt(p.date)}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .post-list { margin: 0; }
  .post-list .row { border-bottom: 1px solid var(--line); }
  .post-list a { border-bottom: 0; }
  .post-list .title { border-bottom: 1px solid transparent; transition: border-color .15s; }
  .post-list a:hover .title { border-bottom-color: var(--fg); }
  .venue {
    display: block;
    font-size: 12px;
    color: var(--muted);
    margin-top: 2px;
    border-bottom: 0 !important;
  }
</style>
