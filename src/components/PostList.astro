---
import type { WritingEntry } from '../data/writing';

interface Props {
  posts: WritingEntry[];
  dateFormat?: 'short' | 'long';
}

const { posts, dateFormat = 'short' } = Astro.props;

function fmt(d: Date) {
  const pad = (n: number) => String(n).padStart(2, '0');
  const ym = `${d.getFullYear()}.${pad(d.getMonth() + 1)}`;
  return dateFormat === 'long' ? `${ym}.${pad(d.getDate())}` : ym;
}
---
<ul class="post-list">
  {posts.map((p) => (
    <li>
      <a href={p.url} class="row" target="_blank" rel="noopener">
        <span class="entry">
          <span class="title">{p.title}</span>
          {(p.authors || p.venue) && (
            <span class="venue">{[p.authors, p.venue].filter(Boolean).join(' · ')}</span>
          )}
        </span>
        <span class="date">{fmt(p.date)}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .post-list { margin: 0; }
  .post-list .row { padding: 12px 0; border-bottom: 1px solid var(--line); }
  .post-list li:last-child .row { border-bottom: 0; }
  .post-list a { border-bottom: 0; }
  .post-list a:hover { color: var(--fg); }
  .post-list .title {
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.35;
    border-bottom: 1px solid transparent;
    transition: border-color .15s;
  }
  .post-list a:hover .title { border-bottom-color: var(--fg); }
  .venue {
    display: block;
    font-size: 12px;
    color: var(--muted);
    margin-top: 4px;
    border-bottom: 0 !important;
  }
</style>
