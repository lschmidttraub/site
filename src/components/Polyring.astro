---
// Minimal Polyring webring link. The prev/next arrows stay hidden until the
// script below finds this site's hostname in polyring.ch's embed member list
// (so they don't show on localhost).
---
<nav class="polyring" aria-label="Polyring webring">
  <span>This site is part of</span>
  <a id="polyring-prev" class="arrow" hidden aria-label="Previous site in Polyring" title="Previous site">←</a>
  <a href="https://polyring.ch">Polyring</a>
  <a id="polyring-next" class="arrow" hidden aria-label="Next site in Polyring" title="Next site">→</a>
</nav>
<script is:inline>
  (function () {
    var s = document.createElement('script');
    s.src = 'https://polyring.ch/embed.js';
    s.async = true;
    s.onload = function () {
      try {
        // MEMBERS is a top-level const in embed.js, shared via the global lexical scope.
        var m = MEMBERS;
        var i = m.findIndex(function (x) { return x.url.includes(location.hostname); });
        if (i < 0) return;
        var prev = document.getElementById('polyring-prev');
        var next = document.getElementById('polyring-next');
        prev.href = m[(i - 1 + m.length) % m.length].url;
        next.href = m[(i + 1) % m.length].url;
        prev.hidden = next.hidden = false;
      } catch (_) {}
    };
    document.head.appendChild(s);
  })();
</script>
<style>
  .polyring { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; }
  .polyring .arrow {
    display: inline-flex;
    font-size: 18px;
    line-height: 1;
    /* Inter's arrows sit below the x-height centre; nudge them up. */
    transform: translateY(-2px);
  }
  .polyring .arrow[hidden] { display: none; }
  .polyring a { color: var(--muted); border-bottom: 0; }
  .polyring a:hover { color: var(--fg); }
</style>
